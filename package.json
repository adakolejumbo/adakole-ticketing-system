{
  "name": "adakole-ticketing-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adakole Ticketing System (ATS) - an MSP service desk: omnichannel intake, routing, SLAs, knowledge base and reporting.",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node --env-file=.env scripts/setup-db.js",
    "db:reset": "node --env-file=.env scripts/setup-db.js --reset"
  },
  "engines": { "node": ">=20.6" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
