# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Protects POST /api/setup (creates tables + demo data on a fresh database)
SETUP_KEY=replace-with-another-secret

# Shared secret that email/chat/social/phone providers must send to /api/inbound/:channel
INBOUND_KEY=replace-with-inbound-secret

# Optional: AI triage when no routing rule matches
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: send email to requesters when an agent replies publicly (resend.com)
RESEND_API_KEY=
MAIL_FROM=Adakole Service Desk <support@yourdomain.com>
APP_URL=http://localhost:5173
